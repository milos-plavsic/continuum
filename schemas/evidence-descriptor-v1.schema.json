{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.dev/schemas/evidence-descriptor-v1.schema.json",
  "title": "Continuum Evidence Record 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["descriptor", "payload"],
  "properties": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_type", "subject", "issuer", "source_authority", "observed_at", "expires_at", "payload_digest", "authentication", "trust_policy", "profile"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "source_authority": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1}
          }
        },
        "trust_policy": {"type": "string", "minLength": 1},
        "profile": {"const": "continuum/evidence-descriptor/1"}
      }
    },
    "payload": {"type": "object"}
  }
}
