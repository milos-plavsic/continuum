{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/milos-plavsic/continuum/schemas/environment-inventory-v1.schema.json",
  "title": "Continuum environment inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "variables"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "continuum/environment-inventory/1.0"},
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variable"}
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "owner", "kind", "type", "required_in", "sensitivity", "evidence_policy", "consumers"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "description": {"type": "string", "minLength": 12},
        "owner": {"enum": ["application", "deployment", "evidence", "judge-gateway", "platform", "video"]},
        "kind": {"enum": ["runtime", "operator-input", "platform-provided", "secret", "secret-reference"]},
        "type": {"enum": ["boolean", "digest", "duration-hours", "email", "identifier", "integer", "path", "principal", "resource-name", "string", "url"]},
        "required_in": {"type": "array", "uniqueItems": true, "items": {"enum": ["cloud-runtime", "cloud-bootstrap", "cloud-deploy", "cloud-proof", "judge-deploy", "local", "showcase-deploy", "video"]}},
        "default": {"type": ["string", "integer", "boolean"]},
        "sensitivity": {"enum": ["public", "internal", "secret"]},
        "evidence_policy": {"enum": ["include", "redact", "forbid"]},
        "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "constraints": {"type": "string", "minLength": 3}
      }
    }
  }
}
