{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.dev/schema/0.1/contract.schema.json",
  "title": "Continuity Contract Profile 0.1-draft envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "artifact_type", "schema", "artifact_id", "issued_at", "issuer", "body", "required_features", "extensions", "digest", "signatures"],
  "properties": {
    "protocol": {"const": "continuum/0.1-draft"},
    "artifact_type": {"enum": ["obligation", "authority_grant", "succession_manifest", "revocation_proof", "execution_receipt", "continuity_attestation"]},
    "schema": {"type": "string", "format": "uri"},
    "artifact_id": {"type": "string", "format": "uri"},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "issuer": {"type": "string", "format": "uri"},
    "body": {"type": "object"},
    "required_features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "extensions": {"type": "object"},
    "digest": {"$ref": "#/$defs/digest"},
    "signatures": {"type": "array", "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "digest": {
      "type": "object", "additionalProperties": false, "required": ["alg", "value"],
      "properties": {"alg": {"const": "sha-256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "artifact_ref": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_type", "digest"],
      "properties": {"artifact_id": {"type": "string", "format": "uri"}, "artifact_type": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "signature": {
      "type": "object", "additionalProperties": false, "required": ["alg", "key_id", "signed_at", "value"],
      "properties": {"alg": {"const": "Ed25519"}, "key_id": {"type": "string", "format": "uri"}, "signed_at": {"type": "string", "format": "date-time"}, "value": {"type": "string"}}
    }
  }
}

