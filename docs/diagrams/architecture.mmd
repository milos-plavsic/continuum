%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 48, "rankSpacing": 60}, "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryTextColor": "#172033", "lineColor": "#64748B", "clusterBkg": "#FFFFFF", "clusterBorder": "#CBD5E1"}}}%%
flowchart TB
  classDef human fill:#FFF7ED,stroke:#C2410C,color:#431407,stroke-width:2px
  classDef control fill:#EFF6FF,stroke:#1D4ED8,color:#172554,stroke-width:2px
  classDef agent fill:#F5F3FF,stroke:#7C3AED,color:#2E1065,stroke-width:2px
  classDef state fill:#ECFDF5,stroke:#047857,color:#022C22,stroke-width:2px
  classDef verify fill:#FDF2F8,stroke:#BE185D,color:#500724,stroke-width:2px
  classDef observe fill:#F8FAFC,stroke:#475569,color:#0F172A,stroke-width:1.5px

  OP["OPERATOR<br/><small>IAM-authenticated</small>"]:::human

  subgraph CLOUD["GOOGLE CLOUD · DEPLOYED REFERENCE BINDING"]
    direction TB

    subgraph DURABLE["DURABLE ORCHESTRATION"]
      direction LR
      CP["CONTROL PLANE<br/><small>private Cloud Run<br/>ledger · policy · fencing</small>"]:::control

      FS[("FIRESTORE<br/><small>append-only events · projections<br/>outbox · authority · run journal</small>")]:::state
      PS["PUB/SUB<br/><small>authenticated push<br/>at-least-once delivery</small>"]:::state
      PUSH["CONTROL PUSH ROUTE<br/><small>same control-plane identity<br/>idempotent reconciliation</small>"]:::control
    end

    subgraph ACTION["GOVERNED SUCCESSION AND ACTION"]
      direction LR
      V17["PREDECESSOR · v17<br/><small>DENIED after succession<br/>stale epoch + revoked memory</small>"]:::agent
      V18["SUCCESSOR · v18<br/><small>private Cloud Run · epoch 42<br/>Google ADK investigator</small>"]:::agent
      VX["VERTEX AI<br/><small>Gemini 3.6 Flash<br/>typed proposal · no authority</small>"]:::agent
      FX["EFFECT GATEWAY<br/><small>one external effect<br/>despite two deliveries</small>"]:::control
    end

    subgraph ASSURANCE["INDEPENDENT ASSURANCE"]
      direction LR
      IV["INDEPENDENT VERIFIER<br/><small>private Cloud Run · read-only<br/>no execution or Vertex permission</small>"]:::verify
      OBS["CLOUD LOGGING + TRACE<br/><small>run ID · trace ID · revision · identity<br/>delivery attempt · evidence verdict</small>"]:::observe
    end
  end

  CC["CONTENT-ADDRESSED<br/>CONTINUITY CONTRACT<br/><small>grant · manifest · revocation<br/>receipt · attestation</small>"]:::verify

  OP -->|"1 · start canonical run"| CP
  CP -->|"2 · persist + transactional outbox"| FS
  FS -->|"3 · publish"| PS
  PS -->|"4 · deliver + deliberate redelivery"| PUSH
  PUSH -->|"5 · scoped evidence"| V18
  V18 <-->|"ADK request + typed response"| VX
  V18 -->|"6 · idempotency key"| FX

  CP -->|"post-succession action attempt"| V17
  FX -->|"7 · six-artifact bundle"| IV
  IV -->|"8 · PASS / FAIL / INCONCLUSIVE"| CC

  PUSH -. "all components emit correlated evidence" .-> OBS
