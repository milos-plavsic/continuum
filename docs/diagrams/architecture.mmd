%%{init:{"flowchart":{"curve":"linear","nodeSpacing":38,"rankSpacing":46},"themeVariables":{"fontFamily":"Inter,Arial,sans-serif","primaryTextColor":"#10202d","lineColor":"#60788a","clusterBkg":"#ffffff","clusterBorder":"#cbd7df"}}}%%
flowchart TB
  classDef human fill:#fff7ed,stroke:#c2410c,color:#431407,stroke-width:2px
  classDef control fill:#eff6ff,stroke:#1d4ed8,color:#172554,stroke-width:2px
  classDef agent fill:#f5f3ff,stroke:#7c3aed,color:#2e1065,stroke-width:2px
  classDef state fill:#ecfdf5,stroke:#047857,color:#022c22,stroke-width:2px
  classDef verify fill:#fdf2f8,stroke:#be185d,color:#500724,stroke-width:2px

  OP["OPERATOR<br/><small>one IAM-authenticated start</small>"]:::human

  subgraph R1["1 · OBSERVE REAL ABSENCE"]
    direction LR
    CP["CONTROL PLANE<br/><small>private Cloud Run<br/>persist obligation + deadline</small>"]:::control
    TASK["CLOUD TASKS<br/><small>deadline callback<br/>no process sleep</small>"]:::state
    PS["PUB/SUB<br/><small>OIDC push · at-least-once<br/>deliberate redelivery</small>"]:::state
    CP -->|schedule| TASK -->|Sentinel tick| PS
  end

  subgraph R2["2 · SELECT, FENCE, RECONSTRUCT"]
    direction TB
    subgraph R2A[" "]
      direction LR
      REG["SUCCESSOR REGISTRY<br/><small>v18 · v19 · v20<br/>signed health + build evidence</small>"]:::state
      FILTER["ELIGIBILITY GATE<br/><small>health · capability · jurisdiction<br/>contract · scope · trust</small>"]:::control
      GEM["GOOGLE ADK + GEMINI 3.6<br/><small>complete evidence manifest<br/>selective claim-linked citations</small>"]:::agent
      POLICY["DETERMINISTIC POLICY<br/><small>validates choice · epoch CAS<br/>v17 action + memory denied</small>"]:::control
      REG --> FILTER -->|eligible set only| GEM -->|non-authoritative choice| POLICY
    end
    subgraph R2B[" "]
      direction LR
      CTX["MINIMUM CONTEXT<br/><small>verified facts included<br/>poisoned + secret context excluded</small>"]:::control
      GATE["SELECTED ACTION GATEWAY<br/><small>identity · epoch · policy<br/>compliance · idempotency</small>"]:::control
      DB[("FIRESTORE<br/><small>transactional event/outbox<br/>authority · compliance · one effect</small>")]:::state
      CTX --> GATE -->|one transaction| DB
    end
    R2A --> R2B
  end


  subgraph R3["3 · PROVE THE OUTCOME"]
    direction LR
    FIVE["FIVE CONTROL CLAIMS<br/><small>obligation · grant · manifest<br/>revocation · receipt</small>"]:::verify
    IV["INDEPENDENT VERIFIER<br/><small>private Cloud Run<br/>Firestore read-only identity</small>"]:::verify
    SIX["ARTIFACT SIX<br/><small>VERIFIED · FAILED · INCONCLUSIVE<br/>verifier-issued attestation</small>"]:::verify
    TRACE["CLOUD TRACE<br/><small>real OTel spans from every service<br/>exact Trace API read</small>"]:::state
    FIVE --> IV -->|alone issues| SIX
    IV -. correlated evidence .-> TRACE
  end

  subgraph R4["4 · LEARN FROM VERIFIED FACTS ONLY"]
    direction LR
    VFACTS["VERIFIED FACT FILTER<br/><small>five bounded citations<br/>no secrets · no authority</small>"]:::verify
    GEMMA["GEMMA 4<br/><small>cited resilience plan<br/>deterministic admission</small>"]:::agent
    MEDIA["VEO 3.1 + LYRIA 3<br/><small>content-addressed training media<br/>derivative, never evidence</small>"]:::agent
    VFACTS --> GEMMA --> MEDIA
  end

  OP --> R1
  R1 -->|redelivery causes transition| R2
  R2 --> R3
  R3 -. VERIFIED only .-> R4
